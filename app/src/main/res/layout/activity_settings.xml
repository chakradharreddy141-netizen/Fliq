<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Gesture Settings"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any gesture to change its action."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- ILoveYou Gesture Row -->
        <LinearLayout
            android:id="@+id/rowILoveYou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🤟 I Love You" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvILoveYouAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Thumb Up Gesture Row -->
        <LinearLayout
            android:id="@+id/rowThumbUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👍 Thumb Up" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvThumbUpAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Thumb Down Gesture Row -->
        <LinearLayout
            android:id="@+id/rowThumbDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👎 Thumb Down" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvThumbDownAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Closed Fist Gesture Row -->
        <LinearLayout
            android:id="@+id/rowClosedFist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✊ Closed Fist" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvClosedFistAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Open Palm Gesture Row -->
        <LinearLayout
            android:id="@+id/rowOpenPalm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🖐️ Open Palm" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvOpenPalmAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Victory Gesture Row -->
        <LinearLayout
            android:id="@+id/rowVictory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✌️ Victory (Peace Sign)" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvVictoryAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Pointing Up Gesture Row -->
        <LinearLayout
            android:id="@+id/rowPointingUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp"
            android:layout_marginBottom="48dp"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="☝️ Pointing Up" android:textColor="#4FC3F7" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvPointingUpAction" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Loading..." android:textColor="#CCCCCC" android:textSize="15sp" android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
